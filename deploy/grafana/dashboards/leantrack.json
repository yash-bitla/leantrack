{
  "uid": "leantrack",
  "title": "leantrack",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Frames for each second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(leantrack_frames_total[30s])",
          "legendFormat": "frames"
        },
        {
          "refId": "B",
          "expr": "rate(leantrack_detector_runs_total[30s])",
          "legendFormat": "detector runs"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Frame latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(leantrack_frame_latency_seconds_bucket[30s])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(leantrack_frame_latency_seconds_bucket[30s])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Share of frames with a detector result",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(leantrack_detector_runs_total[30s]) / rate(leantrack_frames_total[30s])",
          "legendFormat": "share"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Mean age of a detector result (frames)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(leantrack_detection_age_frames_sum[30s]) / rate(leantrack_detection_age_frames_count[30s])",
          "legendFormat": "age"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reported objects",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "leantrack_reported_objects",
          "legendFormat": "objects"
        }
      ]
    }
  ]
}
